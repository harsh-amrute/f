  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --coverage --passWithNoTests",
    "clear-cache": "react-scripts test --clearCache",
    "eject": "react-scripts eject",
    "lint": "eslint . -f node_modules/eslint-html-reporter/reporter.js -o report.html",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx src --ignore-pattern src/types/*"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.tsx",
      "src/**/*.ts"
    ],
    "coveragePathIgnorePatterns": [
      "src/module-main",
      "src/module-store-transfer"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 0,
        "branches": 0,
        "functions": 0,
        "lines": 0
      },
      "src/components/VectorFLOW": {
        "statements": 90,
        "branches": 90,
        "functions": 90,
        "lines": 90
      },
      "src/VectorFlow/Pages": {
        "statements": 35,
        "branches": 25,
        "functions": 35,
        "lines": 35
      },
      "src/VectorFlow/Services/**/api.ts": {
        "statements": 90,
        "branches": 90,
        "functions": 90,
        "lines": 90
      }
    },
    "moduleNameMapper": {
      "axios": "axios/dist/node/axios.cjs"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/lodash": "^4.14.191",
    "@types/luxon": "^3.2.0",
    "@types/plotly.js": "^2.12.18",
